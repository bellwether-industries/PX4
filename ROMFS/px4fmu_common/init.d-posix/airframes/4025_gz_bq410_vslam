#!/bin/sh
#
# @name Gazebo BQ-410 VSLAM with D455 + optical flow, no mag, no GPS
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=bq410_vslam}

. ${R}etc/init.d-posix/airframes/4022_gz_bq410

# ── External Vision (VIO / VSLAM via D455 + OdometryPublisher) ────
param set EKF2_EV_CTRL 9
param set EKF2_EV_DELAY 10
param set EKF2_EV_NOISE_MD 0
param set EKF2_EV_QMIN 0
param set EKF2_EVP_NOISE 0.05
param set EKF2_EVA_NOISE 0.05
param set EKF2_EVV_NOISE 0.05
param set EKF2_EVP_GATE 5.0
param set EKF2_EVV_GATE 3.0
param set EKF2_EV_POS_X 0.12
param set EKF2_EV_POS_Y 0.0
param set EKF2_EV_POS_Z 0.025
param set EKF2_HGT_REF 2

# ── Optical Flow ─────────────────────────────────────────────────
param set EKF2_OF_CTRL 1
param set EKF2_OF_DELAY 20
param set EKF2_OF_QMIN 1
param set EKF2_OF_N_MIN 0.15
param set EKF2_OF_N_MAX 0.5
param set EKF2_OF_GATE 3.0
param set EKF2_OF_POS_X 0.03
param set EKF2_OF_POS_Y 0.0
param set EKF2_OF_POS_Z 0.08
param set SENS_FLOW_MINHGT 0.08
param set SENS_FLOW_MAXHGT 25.0

# ── Range Finder ─────────────────────────────────────────────────
param set EKF2_RNG_CTRL 2
param set EKF2_RNG_DELAY 5
param set EKF2_RNG_NOISE 0.1
param set EKF2_RNG_GATE 5.0
param set EKF2_RNG_SFE 0.05
param set EKF2_RNG_A_VMAX 2.0
param set EKF2_RNG_A_HMAX 8.0
param set EKF2_MIN_RNG 0.1

# ── Barometer: disabled (height from EV) ─────────────────────────
param set EKF2_BARO_CTRL 0

# ── Magnetometer: disabled (yaw from EV) ─────────────────────────
param set EKF2_MAG_TYPE 5
param set SYS_HAS_MAG 0

# ── GPS: disabled (EV provides position) ─────────────────────────
param set EKF2_GPS_CTRL 0
param set SYS_HAS_GPS 0
param set SIM_GPS_USED 0
param set COM_ARM_WO_GPS 1
