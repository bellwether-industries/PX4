#!/bin/sh
#
# @name Gazebo x500 depth VSLAM with RealSense D435i, no mag, no GPS
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_depth_vslam}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# ── External Vision (VIO / VSLAM via RealSense D435i) ───────────
# Camera mount relative to base_link: .138 .0175 .198 (x500_depth_vslam/model.sdf)
# X=0.138: front bar, 1st-row circular mount, slightly forward of default .12
param set EKF2_EV_CTRL 11
param set EKF2_EV_DELAY 160
param set EKF2_EV_NOISE_MD 0
param set EKF2_EV_QMIN 0
param set EKF2_EVP_NOISE 0.1
param set EKF2_EVA_NOISE 0.2
param set EKF2_EVV_NOISE 0.1
param set EKF2_EVP_GATE 8.0
param set EKF2_EVV_GATE 3.0
param set EKF2_EV_POS_X 0.138
param set EKF2_EV_POS_Y 0.0175
param set EKF2_EV_POS_Z 0.198
param set EKF2_HGT_REF 1

# ── Barometer: disabled (height from EV) ─────────────────────────
param set EKF2_BARO_CTRL 0

# ── Magnetometer: disabled (yaw from EV) ─────────────────────────
param set EKF2_MAG_TYPE 5
param set SYS_HAS_MAG 0

# ── GPS: disabled (EV provides position) ─────────────────────────
param set EKF2_GPS_CTRL 0
param set SYS_HAS_GPS 0
param set SIM_GPS_USED 0
param set COM_ARM_WO_GPS 1

# ── Flight limits ────────────────────────────────────────────────
param set-default MC_YAWRATE_MAX 15
param set-default MPC_XY_VEL_ALL 0.5
