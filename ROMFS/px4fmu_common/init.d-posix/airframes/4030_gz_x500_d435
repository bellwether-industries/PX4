#!/bin/sh
#
# @name Gazebo x500 D435 + optical flow + rangefinder
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_d435}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# ── External Vision (vSLAM via RTAB-Map → MAVROS vision_pose) ────
# Fuse EV horizontal position + yaw only (bit0 + bit3 = 9)
param set-default EKF2_EV_CTRL 9
param set-default EKF2_EV_DELAY 10
param set-default EKF2_EV_NOISE_MD 0
param set-default EKF2_EV_QMIN 0
param set-default EKF2_EVP_NOISE 0.05
param set-default EKF2_EVA_NOISE 0.05
param set-default EKF2_EVP_GATE 5.0
# EV sensor position on airframe (D435 mount offset from CoG)
param set-default EKF2_EV_POS_X 0.12
param set-default EKF2_EV_POS_Y 0.03
param set-default EKF2_EV_POS_Z -0.242

# ── Optical Flow ─────────────────────────────────────────────────
param set-default EKF2_OF_CTRL 1
param set-default EKF2_OF_DELAY 20
param set-default EKF2_OF_QMIN 1
param set-default EKF2_OF_N_MIN 0.15
param set-default EKF2_OF_N_MAX 0.5
param set-default EKF2_OF_GATE 3.0
# Flow sensor position (bottom-centre of airframe)
param set-default EKF2_OF_POS_X 0.03
param set-default EKF2_OF_POS_Y 0.0
param set-default EKF2_OF_POS_Z 0.1
# Flow sensor limits
param set-default SENS_FLOW_MINHGT 0.08
param set-default SENS_FLOW_MAXHGT 25.0

# ── Range Finder (height reference) ─────────────────────────────
param set-default EKF2_RNG_CTRL 1
param set-default EKF2_HGT_REF 2
param set-default EKF2_RNG_DELAY 5
param set-default EKF2_RNG_NOISE 0.1
param set-default EKF2_RNG_GATE 5.0
param set-default EKF2_RNG_SFE 0.05
param set-default EKF2_RNG_A_VMAX 2.0
param set-default EKF2_RNG_A_HMAX 8.0
param set-default EKF2_MIN_RNG 0.1

# ── Magnetometer: disabled (yaw from EV) ────────────────────────
param set-default EKF2_MAG_TYPE 5
param set-default SYS_HAS_MAG 0

# ── GPS: not required for arming (EV provides position) ─────────
param set-default EKF2_GPS_CTRL 0
param set-default SYS_HAS_GPS 0
param set-default SIM_GPS_USED 0
param set-default COM_ARM_WO_GPS 1
